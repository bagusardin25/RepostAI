FRONTEND_PORT=3000
BACKEND_PORT=4000

MINDS_BUILDER_API_KEY=
MINDS_MIND_ID=
MINDS_CONVERSATION_ALIAS=main

# Optional: YouTube channel to auto-ingest (also configurable on the Desk)
YOUTUBE_CHANNEL_URL=

# --- Production (Vercel frontend + Railway backend) ---
# Railway:
# FRONTEND_ORIGIN=https://your-app.vercel.app
# DATA_DIR=/data
# HOST=0.0.0.0
# PORT is set by Railway.
#
# Vercel:
# NEXT_PUBLIC_BACKEND_ORIGIN=https://your-api.up.railway.app
# BACKEND_ORIGIN=https://your-api.up.railway.app
#
# Do not set DATABASE_URL to a Postgres URL. SQLite lives on the Railway volume.
