{
  "name": "repostai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c yellow,cyan \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "next dev frontend --turbopack -p 3000",
    "build": "next build frontend",
    "start": "next start frontend -p 3000",
    "start:backend": "node backend/server.js",
    "lint": "tsc --noEmit",
    "test": "node --test backend/pipeline/recipes.test.js",
    "test:watch": "node --test --watch backend/pipeline/recipes.test.js"
  },
  "dependencies": {
    "@animocabrands/minds-client-lib": "^0.1.4",
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "^5.3.0",
    "next": "^15.5.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "youtubei.js": "^18.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "ffmpeg-static"
    ]
  }
}